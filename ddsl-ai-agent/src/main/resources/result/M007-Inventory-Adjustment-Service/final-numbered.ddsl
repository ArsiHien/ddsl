      1 | BoundedContext Inventory {
      2 | 
      3 |     domain {
      4 |         // @chunk:start DomainModel
      5 |         Aggregate StockItem {
      6 |             @identity stockItemId: UUID
      7 |             sku: String @required
      8 |             quantity: Int @min(0)
      9 |             reservedQuantity: Int @min(0)
     10 |         
     11 |             operations {
     12 |                 when reserving stock with requestedQuantity:
>>   13 |                     require that:
>>   14 |                         - requestedQuantity > 0
>>   15 |                         - quantity >= requestedQuantity
>>   16 |                     then:
>>   17 |                         - decrease quantity by requestedQuantity
>>   18 |                         - increase reservedQuantity by requestedQuantity
>>   19 |                     emit StockReserved with stockItemId
     20 |             }
     21 |         }
     22 |         // @chunk:end DomainModel
     23 |         // @chunk:start DomainServices
     24 |         DomainService InventoryPolicy {
     25 |             when checking reorder need with quantity as Int and reorderPoint as Int:
     26 |                 then:
     27 |                     - calculate reorderNeeded as quantity is less than reorderPoint
     28 |         }
     29 |         // @chunk:end DomainServices
     30 |     }
     31 | 
     32 |     events {
     33 |         // @chunk:start DomainEvents
     34 |         DomainEvent StockReserved {
     35 |             stockItemId: UUID
     36 |             quantity: Int
     37 |             reservedAt: DateTime
     38 |         }
     39 |         // @chunk:end DomainEvents
     40 |     }
     41 | 
     42 | }
