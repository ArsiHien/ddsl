BoundedContext Procurement {

    domain {
        // @chunk:start DomainTypes
        ValueObject Money {
            amount: Decimal @min(0)
            currency: String @required @maxLength(3)
        }
        // @chunk:end DomainTypes
        // @chunk:start DomainModel
        Aggregate PurchaseOrder {
            purchaseOrderId: UUID @identity
            supplierId: String @required
            requesterId: String @required
            lines: List<PurchaseOrderLine>
            totalAmount: Money
            status: String @default("DRAFT")
            approvedAt: DateTime?
        
            Entity PurchaseOrderLine {
                lineId: UUID @identity
                itemCode: String @required
                quantity: Int @min(1)
                unitCost: Money @required
            }
        
            operations {
                when submitting purchase order:
                    require that:
                        - supplierId is required
                        - requesterId is required
                        - lines is not empty
                    then:
                        - calculate totalAmount from line costs
                        - set status to "SUBMITTED"
                    emit PurchaseOrderSubmitted
                when approving purchase order with approvedAt, approverId:
                    require that:
                        - status is "SUBMITTED"
                        - approverId is required
                        - totalAmount > 0
                    then:
                        - set status to "APPROVED"
                        - set approvedAt to approvedAt
                    emit PurchaseOrderApproved
            }
        }
        // @chunk:end DomainModel
        // @chunk:start DomainServices
        DomainService ApprovalPolicy {
            when checking approval requirement with totalAmount and requesterId:
                return totalAmount > 1000
        }
        // @chunk:end DomainServices
    }

    events {
        // @chunk:start DomainEvents
        DomainEvent PurchaseOrderSubmitted {
            id: UUID
            submittedAt: DateTime
            total: Money
        }
        
        DomainEvent PurchaseOrderApproved {
            id: UUID
            approverId: String
            approvedAt: DateTime
        }
        // @chunk:end DomainEvents
    }

    factories {
        // @chunk:start Factories
        Factory PurchaseOrderFactory for PurchaseOrder {
            when creating PurchaseOrder from supplierId, requesterId, lines:
                require that:
                    - lines is not empty
                then:
                    - create PurchaseOrder with new purchaseOrderId, supplierId, requesterId, lines, status set to "DRAFT"
                return PurchaseOrder
        }
        // @chunk:end Factories
    }

}
