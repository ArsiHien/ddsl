      1 | BoundedContext Banking {
      2 | 
      3 |     domain {
      4 |         // @chunk:start DomainModel
      5 |         Aggregate Account {
      6 |             accountId: UUID @identity
      7 |             ownerName: String @required
      8 |             balance: Decimal @min(0)
      9 |             status: String
     10 |         
     11 |             invariants {
     12 |                 "Balance must never be negative": balance >= 0
     13 |                 "Status must be one of OPEN, FROZEN, or CLOSED": status == "OPEN" or status == "FROZEN" or status == "CLOSED"
     14 |             }
     15 |         
     16 |             operations {
     17 |                 when depositing with amount:
     18 |                     require that:
     19 |                         - amount is required
     20 |                         - amount > 0
     21 |                     then:
>>   22 |                         - increase balance by amount
     23 |                 when freezing account:
     24 |                     require that:
     25 |                         - status == "OPEN"
     26 |                     then:
     27 |                         - set status to "FROZEN"
     28 |             }
     29 |         }
     30 |         // @chunk:end DomainModel
     31 |     }
     32 | 
     33 | }
