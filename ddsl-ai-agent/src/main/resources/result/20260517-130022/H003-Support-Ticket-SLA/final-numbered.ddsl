      1 | BoundedContext Support {
      2 | 
      3 |     domain {
      4 |         // @chunk:start DomainServices
      5 |         DomainService SlaPolicy {
      6 |             when calculating first response due with priority: String and createdAt: DateTime:
      7 |                 then:
      8 |                     - calculate firstResponseDueAt as createdAt plus priority duration
      9 |         }
     10 |         // @chunk:end DomainServices
     11 |     }
     12 | 
     13 |     events {
     14 |         // @chunk:start DomainEvents
     15 |         DomainEvent TicketAssigned {
     16 |             ticketId: UUID
     17 |             agentId: String
     18 |             assignedAt: DateTime
     19 |         }
     20 |         DomainEvent TicketResolved {
     21 |             ticketId: UUID
     22 |             resolvedAt: DateTime
     23 |         }
     24 |         // @chunk:end DomainEvents
     25 |     }
     26 | 
     27 |     specifications {
     28 |         // @chunk:start Specifications
     29 |         Specification OverdueTicket {
     30 |             matches Ticket where:
     31 |                 - firstResponseDueAt is before now
     32 |                 - status is not "RESOLVED"
     33 |         }
     34 |         // @chunk:end Specifications
     35 |     }
     36 | 
     37 | }
