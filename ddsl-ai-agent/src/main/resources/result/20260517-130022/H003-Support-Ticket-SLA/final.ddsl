BoundedContext Support {

    domain {
        // @chunk:start DomainServices
        DomainService SlaPolicy {
            when calculating first response due with priority: String and createdAt: DateTime:
                then:
                    - calculate firstResponseDueAt as createdAt plus priority duration
        }
        // @chunk:end DomainServices
    }

    events {
        // @chunk:start DomainEvents
        DomainEvent TicketAssigned {
            ticketId: UUID
            agentId: String
            assignedAt: DateTime
        }
        DomainEvent TicketResolved {
            ticketId: UUID
            resolvedAt: DateTime
        }
        // @chunk:end DomainEvents
    }

    specifications {
        // @chunk:start Specifications
        Specification OverdueTicket {
            matches Ticket where:
                - firstResponseDueAt is before now
                - status is not "RESOLVED"
        }
        // @chunk:end Specifications
    }

}
