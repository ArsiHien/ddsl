      1 | BoundedContext Returns {
      2 | 
      3 |     domain {
      4 |         // @chunk:start DomainTypes
      5 |         ValueObject Money {
      6 |             amount: Decimal @min(0)
      7 |             currency: String @required @maxLength(3)
      8 |         }
      9 |         // @chunk:end DomainTypes
     10 |         // @chunk:start DomainModel
     11 |         Aggregate ReturnRequest {
     12 |             @identity returnId: UUID
     13 |             orderId: UUID @required
     14 |             customerId: String @required
     15 |             items: List<ReturnLine>
     16 |             reason: String @required
     17 |             status: String @default("REQUESTED")
     18 |             requestedAt: DateTime
     19 |             inspectedAt: DateTime?
     20 |             refundAmount: Money
     21 |         
     22 |             invariants {
>>   23 |                 "All items must have quantity greater than zero": items.every(item -> item.quantity > 0)
     24 |                 "Reason must not be empty": reason is not empty
     25 |             }
     26 |         
     27 |             operations {
     28 |                 when approving return with inspectedAt:
     29 |                     require that:
     30 |                         - status is "REQUESTED"
     31 |                         - reason is not empty
     32 |                     then:
     33 |                         - calculate refundAmount as sum of items.lineRefund
     34 |                         - set status to "APPROVED"
     35 |                         - set inspectedAt to now
     36 |                     emit ReturnApproved with returnId, refundAmount, approvedAt
     37 |         
     38 |                 when rejecting return with rejectionReason:
     39 |                     require that:
     40 |                         - status is "REQUESTED"
     41 |                         - rejectionReason is not empty
     42 |                     then:
     43 |                         - set status to "REJECTED"
     44 |                     emit ReturnRejected with returnId, rejectionReason, rejectedAt
     45 |             }
     46 |         }
     47 |         
     48 |         Entity ReturnLine {
     49 |             @identity returnLineId: UUID
     50 |             productId: String @required
     51 |             quantity: Int @min(1)
     52 |             condition: String @required
     53 |             lineRefund: Money
     54 |         }
     55 |         // @chunk:end DomainModel
     56 |     }
     57 | 
     58 |     events {
     59 |         // @chunk:start DomainEvents
     60 |         DomainEvent ReturnApproved {
     61 |             returnId: UUID
     62 |             refundAmount: Money
     63 |             approvedAt: DateTime
     64 |         }
     65 |         DomainEvent ReturnRejected {
     66 |             returnId: UUID
     67 |             rejectionReason: String
     68 |             rejectedAt: DateTime
     69 |         }
     70 |         // @chunk:end DomainEvents
     71 |     }
     72 | 
     73 |     repositories {
     74 |         // @chunk:start Repositories
     75 |         Repository ReturnRequestRepository for ReturnRequest {
     76 |             findById(id: UUID): ReturnRequest?
     77 |             findByOrderId(orderId: UUID): List<ReturnRequest>
     78 |             save(request: ReturnRequest): Void
     79 |         }
     80 |         // @chunk:end Repositories
     81 |     }
     82 | 
     83 | }
