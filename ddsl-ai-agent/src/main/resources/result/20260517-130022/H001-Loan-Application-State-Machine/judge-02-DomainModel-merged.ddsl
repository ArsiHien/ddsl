BoundedContext Lending {

    domain {
        // @chunk:start DomainModel
        Aggregate LoanApplication {
            @identity applicationId: UUID
            applicantId: String @required
            requestedAmount: Decimal @min(1000)
            creditScore: Int @min(300) @max(850)
            status: String @default("DRAFT")
            submittedAt: DateTime?
            approvedAt: DateTime?
        
            invariants {
                "Status must be one of DRAFT, SUBMITTED, APPROVED, REJECTED, WITHDRAWN": status == "DRAFT" or status == "SUBMITTED" or status == "APPROVED" or status == "REJECTED" or status == "WITHDRAWN"
            }
        
            operations {
                when submitting application with submittedAt:
                    require that:
                        - applicantId is required
                        - requestedAmount is required
                        - creditScore is required
                        - status is "DRAFT"
                    then:
                        - set status to "SUBMITTED"
                        - set submittedAt to submittedAt
                    emit LoanApplicationSubmitted with applicationId, submittedAt
        
                when approving application with approvedAt:
                    require that:
                        - status is "SUBMITTED"
                        - creditScore > 650
                        - requestedAmount > 0
                    then:
                        - set status to "APPROVED"
                        - set approvedAt to approvedAt
                    emit LoanApplicationApproved with applicationId, approvedAt
            }
        }
        // @chunk:end DomainModel
    }

    events {
        // @chunk:start DomainEvents
        DomainEvent LoanApplicationSubmitted {
            applicationId: UUID
            submittedAt: DateTime
        }
        
        DomainEvent LoanApplicationApproved {
            applicationId: UUID
            approvedAt: DateTime
        }
        // @chunk:end DomainEvents
    }

    repositories {
        // @chunk:start Repositories
        Repository LoanApplicationRepository for LoanApplication {
            findById(id: UUID): LoanApplication?
            save(loanApplication: LoanApplication): Void
        }
        // @chunk:end Repositories
    }

    specifications {
        // @chunk:start Specifications
        Specification ApprovableLoan {
            matches LoanApplication where:
                - status is "SUBMITTED"
                - creditScore is greater than 650
        }
        // @chunk:end Specifications
    }

}
