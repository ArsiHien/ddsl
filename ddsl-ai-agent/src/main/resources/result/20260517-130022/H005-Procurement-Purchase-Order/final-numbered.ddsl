      1 | BoundedContext Procurement {
      2 | 
      3 |     domain {
      4 |         // @chunk:start DomainTypes
      5 |         ValueObject Money {
      6 |             amount: Decimal @min(0)
      7 |             currency: String @required @maxLength(3)
      8 |         }
      9 |         // @chunk:end DomainTypes
     10 |         // @chunk:start DomainModel
     11 |         Aggregate PurchaseOrder {
     12 |             purchaseOrderId: UUID @identity
     13 |             supplierId: String @required
     14 |             requesterId: String @required
     15 |             lines: List<PurchaseOrderLine>
     16 |             totalAmount: Money
     17 |             status: String @default("DRAFT")
     18 |             approvedAt: DateTime?
     19 |         
     20 |             Entity PurchaseOrderLine {
     21 |                 lineId: UUID @identity
     22 |                 itemCode: String @required
     23 |                 quantity: Int @min(1)
     24 |                 unitCost: Money @required
     25 |             }
     26 |         
     27 |             operations {
     28 |                 when submitting purchase order:
     29 |                     require that:
     30 |                         - supplierId is required
     31 |                         - requesterId is required
     32 |                         - lines is not empty
     33 |                     then:
     34 |                         - calculate totalAmount from line costs
     35 |                         - set status to "SUBMITTED"
     36 |                     emit PurchaseOrderSubmitted
     37 |                 when approving purchase order with approvedAt, approverId:
     38 |                     require that:
     39 |                         - status is "SUBMITTED"
     40 |                         - approverId is required
     41 |                         - totalAmount > 0
     42 |                     then:
     43 |                         - set status to "APPROVED"
     44 |                         - set approvedAt to approvedAt
     45 |                     emit PurchaseOrderApproved
     46 |             }
     47 |         }
     48 |         // @chunk:end DomainModel
     49 |         // @chunk:start DomainServices
     50 |         DomainService ApprovalPolicy {
     51 |             when checking approval requirement with totalAmount and requesterId:
>>   52 |                 return totalAmount > 1000
>>   53 |         }
     54 |         // @chunk:end DomainServices
     55 |     }
     56 | 
     57 |     events {
     58 |         // @chunk:start DomainEvents
     59 |         DomainEvent PurchaseOrderSubmitted {
     60 |             id: UUID
     61 |             submittedAt: DateTime
     62 |             total: Money
     63 |         }
     64 |         
     65 |         DomainEvent PurchaseOrderApproved {
     66 |             id: UUID
     67 |             approverId: String
     68 |             approvedAt: DateTime
     69 |         }
     70 |         // @chunk:end DomainEvents
     71 |     }
     72 | 
     73 |     factories {
     74 |         // @chunk:start Factories
>>   75 |         Factory PurchaseOrderFactory for PurchaseOrder {
>>   76 |             when creating PurchaseOrder from supplierId, requesterId, lines:
>>   77 |                 require that:
>>   78 |                     - lines is not empty
>>   79 |                 then:
>>   80 |                     - create PurchaseOrder with new purchaseOrderId, supplierId, requesterId, lines, status set to "DRAFT"
>>   81 |                 return PurchaseOrder
>>   82 |         }
     83 |         // @chunk:end Factories
     84 |     }
     85 | 
     86 | }
