      1 | BoundedContext Events {
      2 | 
      3 |     domain {
      4 |     }
      5 | 
      6 |     events {
      7 |         // @chunk:start DomainEvents
      8 |         DomainEvent TicketReserved {
      9 |             registrationId: UUID
     10 |             eventId: UUID
     11 |             expiresAt: DateTime
     12 |         }
