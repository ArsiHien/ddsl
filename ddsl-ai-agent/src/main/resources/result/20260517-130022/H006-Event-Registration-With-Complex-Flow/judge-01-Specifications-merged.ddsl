BoundedContext Events {

    domain {
    }

    events {
        // @chunk:start DomainEvents
        DomainEvent TicketReserved {
            registrationId: UUID
            eventId: UUID
            expiresAt: DateTime
        }
        DomainEvent RegistrationConfirmed {
            registrationId: UUID
            confirmedAt: DateTime
        }
        DomainEvent AttendeeCheckedIn {
            registrationId: UUID
            checkedInAt: DateTime
        }
        // @chunk:end DomainEvents
    }

    repositories {
        // @chunk:start Repositories
        Repository EventRegistrationRepository for EventRegistration {
            findById(id: UUID): EventRegistration?
            findByEventId(eventId: UUID): List<EventRegistration>
            findByAttendeeEmail(attendeeEmail: String): List<EventRegistration>
            save(eventRegistration: EventRegistration): Void
        }
        // @chunk:end Repositories
    }

    specifications {
        // @chunk:start Specifications
        Specification ExpiredReservation {
            matches EventRegistration where:
                - expiresAt is before now
                - status is RESERVED
        }
        
        Specification ConfirmedRegistration {
            matches EventRegistration where:
                - status is CONFIRMED
        }
        // @chunk:end Specifications
    }

}
